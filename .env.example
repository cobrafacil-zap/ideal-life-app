# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Configurações do projeto > API, em supabase.com/dashboard)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica-aqui

# Chave da API do Google Gemini (para análise de foto do prato).
# Obtenha em https://aistudio.google.com/apikey
GOOGLE_API_KEY=sua-google-api-key-aqui
